<odoo noupdate="1"><record id="access_notification" model="mail.template"><field name="name">Training: autonomous access activated</field><field name="model_id" ref="model_training_elearning_sale_allocation"/><field name="subject">Your learning access is activated</field><field name="lang">{{ object.partner_id.lang }}</field><field name="email_to">{{ object.partner_id.email }}</field><field name="body_html" type="html"><div><p>Hello <t t-out="object.partner_id.name or ''"/>,</p><p>Your access to the course <t t-out="object.line_id.learning_channel_id.name"/> is activated until <t t-out="format_date(object.access_ends_at, date_format='d MMMM y')"/>.</p><p><a t-att-href="'/my/learning/%s' % object.membership_id.id">Open my learner space</a></p></div></field></record><record id="cron_access_notification_errors" model="ir.cron"><field name="name">Autonomous access notification failures</field><field name="model_id" ref="model_training_elearning_sale_allocation"/><field name="state">code</field><field name="code">model._cron_learning_notifications()</field><field name="interval_number">1</field><field name="interval_type">hours</field></record></odoo>
