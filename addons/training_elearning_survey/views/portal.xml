<odoo>
 <template id="workspace" name="My autonomous courses"><t t-call="training_elearning.workspace"/></template>
 <template id="course" name="Private autonomous course"><t t-call="training_elearning.course"/></template>
 <template id="exam_start" name="Start autonomous mock exam"><t t-call="portal.portal_layout"><div class="container py-4"><a t-att-href="'/my/learning/%s' % member.id">Mon cours</a><h1 t-out="row.exam_id.title"/><p>Durée : <t t-out="row.exam_id.time_limit"/> minutes. Le chronomètre serveur continue en cas de déconnexion.</p><form method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="btn btn-primary">Commencer ou reprendre une tentative</button></form><h2>Mes tentatives</h2><ul><li t-foreach="attempts" t-as="attempt"><a t-att-href="'/my/learning-exams/%s' % attempt.id"><t t-out="attempt.start_datetime"/> · <t t-if="attempt.state=='done'">Résultat et correction</t><t t-else="">Reprendre</t></a></li></ul></div></t></template>
</odoo>
