<odoo>
 <record id="activity_notice" model="mail.template"><field name="name">eLearning: activity availability</field><field name="model_id" ref="model_training_elearning_notice"/><field name="subject">Information about your course {{ object.membership_id.channel_id.name }}</field><field name="lang">{{ object.membership_id.learning_user_id.partner_id.lang }}</field><field name="email_from">{{ object.company_id.partner_id.email_formatted or user.partner_id.email_formatted }}</field><field name="partner_to">{{ object.membership_id.learning_user_id.partner_id.id }}</field><field name="auto_delete" eval="False"/><field name="body_html" type="html"><div><p>Hello,</p><p t-if="object.kind == 'withdrawal'">The organization has closed an activity of your course. Previous achievements and answers already recorded are kept. An unavailable requirement is neither failed nor automatically validated. The coordination is reviewing the consequences for your deadlines.</p><p t-else="">The organization has reopened an activity of your course. Your dates and access rights remain those planned for your membership.</p><p><a t-att-href="object.get_base_url() + '/my/learning/%s' % object.membership_id.id">View your authenticated space</a></p><p>Questions, answer keys and learning files remain in this private space.</p></div></field></record>
 <record id="cron_learning_notices" model="ir.cron"><field name="name">eLearning : suivi des notifications privées</field><field name="model_id" ref="model_training_elearning_notice"/><field name="state">code</field><field name="code">model._cron_learning_notices()</field><field name="interval_number">10</field><field name="interval_type">minutes</field><field name="active" eval="True"/></record>
</odoo>
