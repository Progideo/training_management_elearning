<odoo>
 <record id="certificate_notice_template" model="mail.template"><field name="name">eLearning: certificate history changed</field><field name="model_id" ref="model_training_elearning_certificate_notice"/><field name="subject">Update of your eLearning certificates</field><field name="lang">{{ object.certificate_id.user_id.partner_id.lang }}</field><field name="email_from">{{ object.company_id.partner_id.email_formatted or user.partner_id.email_formatted }}</field><field name="partner_to">{{ object.certificate_id.user_id.partner_id.id }}</field><field name="auto_delete" eval="False"/><field name="body_html" type="html"><div><p>Your eLearning certificate history has been updated. View the current status and your documents in your authenticated personal space.</p><p><a t-att-href="object.get_base_url() + '/my/learning-certificates'">View my certificates</a></p><p>Documents and verification links are not attached to this message.</p></div></field></record>
 <record id="cron_certificate_notifications" model="ir.cron"><field name="name">eLearning : suivi des notifications d’attestation</field><field name="model_id" ref="model_training_elearning_certificate_notice"/><field name="state">code</field><field name="code">model._cron_certificate_notifications()</field><field name="interval_number">5</field><field name="interval_type">minutes</field><field name="active" eval="True"/></record>
</odoo>
