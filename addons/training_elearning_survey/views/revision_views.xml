<odoo>
 <record id="exam_revision_form" model="ir.ui.view"><field name="name">learning.exam.revision.form</field><field name="model">training.elearning.exam.revision</field><field name="arch" type="xml"><form string="Nouvelle version d’examen"><group><field name="slide_id" readonly="1"/><field name="exam_id" domain="[('training_state','=','published')]" options="{'no_create':True}"/><field name="reason"/></group><p>Les obligations et versions déjà vendues ou attribuées restent conservées. Un changement d’obligation ou de programme substantiel exige une nouvelle édition.</p><footer><button name="action_apply" type="object" string="Appliquer pour les nouvelles ventes et inscriptions" class="btn-primary"/><button special="cancel" string="Annuler"/></footer></form></field></record>
 <record id="course_exam_revision_form" model="ir.ui.view"><field name="name">learning.course.exam.revision</field><field name="model">slide.channel</field><field name="inherit_id" ref="training_elearning_survey.course_exam_form"/><field name="arch" type="xml"><xpath expr="//field[@name='slide_ids']/form/group[@name='learning_content']" position="inside"><button name="action_learning_exam_revision" type="object" string="Sélectionner une nouvelle version" groups="training_mock_exam.group_mock_exam_author" invisible="slide_category != 'certification' or not id"/></xpath></field></record>
</odoo>
