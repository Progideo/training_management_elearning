<odoo>
  <record id="course_form" model="ir.ui.view">
    <field name="name">training.elearning.course.form</field>
    <field name="model">slide.channel</field>
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <form string="Édition de cours autonome">
        <header><button name="action_learning_editorial" type="object" string="Correction éditoriale" groups="training_elearning.group_elearning_author" invisible="learning_state != 'published'"/>
          <button name="action_learning_publish" type="object" string="Publier l’édition" class="btn-primary" invisible="learning_state != 'draft'" groups="training_elearning.group_elearning_author" />
          <field name="learning_state" widget="statusbar" />
        </header>
        <sheet>
          <group>
            <field name="name" />
            <field name="training_course_id" readonly="id" required="1" />
            <field name="learning_company_id" readonly="1" />
            <field name="active" />
            <field name="prerequisite_channel_ids" widget="many2many_tags" domain="[('training_course_id','!=',False)]" />
          </group>
          <notebook>
            <page string="Activités">
              <field name="slide_ids" context="{'default_is_published': True}">
                <list>
                  <field name="sequence" widget="handle" />
                  <field name="name" />
                  <field name="slide_category" />
                  <field name="learning_optional" />
                  <field name="is_published" />
                </list>
                <form string="Activity">
                  <group>
                    <field name="name" />
                    <field name="channel_id" invisible="1" />
                    <field name="slide_category" />
                    <field name="sequence" />
                    <field name="is_published" />
                    <field name="learning_optional" />
                    <field name="learning_prerequisite_ids" widget="many2many_tags" domain="[('channel_id','=',channel_id),('is_category','=',False)]" />
                  </group>
                  <group name="learning_content"><button name="action_learning_editorial" type="object" string="Correction éditoriale tracée" invisible="not id or slide_category not in ('article','document','video')"/>
                    <field name="html_content" widget="html" invisible="slide_category != 'article'" />
                    <field name="source_type" invisible="slide_category != 'document'" />
                    <field name="learning_filename" invisible="1" />
                    <field name="binary_content" filename="learning_filename" invisible="slide_category != 'document'" />
                    <field name="video_url" invisible="slide_category != 'video'" />
                    <field name="learning_public_video" invisible="slide_category != 'video'" />
                  </group>
                </form>
              </field>
            </page>
            <page string="Présentation privée">
              <field name="description_html" />
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="course_list" model="ir.ui.view">
    <field name="name">training.elearning.course.list</field>
    <field name="model">slide.channel</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="training_course_id" />
        <field name="learning_state" />
        <field name="learning_company_id" />
      </list>
    </field>
  </record>
  <record id="course_action" model="ir.actions.act_window">
    <field name="name">Cours autonomes</field>
    <field name="res_model">slide.channel</field>
    <field name="view_mode">list,form</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode':'list','view_id':ref('course_list')}), (0, 0, {'view_mode':'form','view_id':ref('course_form')})]" />
    <field name="domain">[('training_course_id', '!=', False)]</field>
  </record>
  <record id="member_form" model="ir.ui.view">
    <field name="name">training.elearning.membership.form</field>
    <field name="model">slide.channel.partner</field>
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <form string="Accès apprenant">
        <header>
          <button name="action_learning_access" type="object" string="Gérer l’accès" groups="training_elearning.group_elearning_manager" />
          <field name="learning_state" widget="statusbar" />
        </header>
        <sheet>
          <group>
            <field name="channel_id" readonly="id" domain="[('training_course_id','!=',False)]" />
            <field name="partner_id" readonly="id" />
            <field name="learning_user_id" readonly="1" />
            <field name="learning_started_at" readonly="1" />
            <field name="learning_ends_at" readonly="1" />
            <field name="completion" readonly="1" />
            <field name="member_status" readonly="1" />
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="member_action" model="ir.actions.act_window">
    <field name="name">Accès apprenants</field>
    <field name="res_model">slide.channel.partner</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="member_form" />
    <field name="domain">[('channel_id.training_course_id','!=',False)]</field>
  </record>
  <menuitem id="learning_root" name="Apprentissage autonome" sequence="60" groups="training_elearning.group_elearning_author" />
  <menuitem id="learning_courses" name="Cours autonomes" parent="learning_root" action="course_action" />
  <menuitem id="learning_members" name="Accès apprenants" parent="learning_root" action="member_action" groups="training_elearning.group_elearning_manager" />
</odoo>
