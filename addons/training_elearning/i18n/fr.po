#: code:addons/training_elearning/models/course.py:0
msgid "eLearning coordination permission is required."
msgstr "Le droit de coordination eLearning est requis."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/course.py:0
#: code:addons/training_elearning/models/course.py:0
msgid "Use courses in your active companies."
msgstr "Utilisez les cours de vos sociétés actives."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/course.py:0
msgid "Publish the course through its controlled action."
msgstr "Publiez le cours avec son action dédiée."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/course.py:0
msgid "Create a new course edition instead of changing its identity."
msgstr "Créez une nouvelle édition pour changer l’identité du cours."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/course.py:0
msgid "Use the controlled course actions."
msgstr "Utilisez les actions dédiées du cours."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/course.py:0
msgid "Keep this course private and on controlled invitation."
msgstr "Conservez le cours privé avec activation contrôlée des accès."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/course.py:0
#: code:addons/training_elearning/models/course.py:0
#: code:addons/training_elearning/models/course.py:0
msgid "Create a new edition for changed content or obligations."
msgstr "Créez une nouvelle édition pour modifier les contenus ou obligations."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/course.py:0
msgid "Check the course identity, active state and prerequisites."
msgstr "Vérifiez la formation, l’état actif et les prérequis du cours."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/course.py:0
msgid "Choose supported published course activities."
msgstr "Choisissez des activités publiées prises en charge."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/membership.py:0
#: code:addons/training_elearning/models/membership.py:0
msgid "Use controlled learner access actions."
msgstr "Utilisez les actions dédiées des accès apprenants."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/membership.py:0
msgid "Provide a reason and a future access end."
msgstr "Indiquez un motif et une date de fin d’accès future."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/membership.py:0
msgid "Publish an active course before activation."
msgstr "Publiez un cours actif avant d’activer les accès."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/membership.py:0
msgid "Choose the active Odoo account of this learner."
msgstr "Choisissez le compte Odoo actif de cet apprenant."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/membership.py:0
msgid "An activated membership keeps its learner identity."
msgstr "Un accès déjà activé conserve son compte apprenant."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/membership.py:0
msgid "Renewal cannot shorten active access."
msgstr "Un renouvellement ne peut pas raccourcir un accès actif."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/membership.py:0
msgid "Provide an access change reason."
msgstr "Indiquez le motif de modification de l’accès."

#. module: training_elearning
#. odoo-python
#: code:addons/training_elearning/models/membership.py:0
msgid "This private course is unavailable."
msgstr "Ce cours privé est indisponible."

