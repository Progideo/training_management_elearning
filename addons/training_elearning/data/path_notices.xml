<odoo>
 <record id="path_activation_notice" model="mail.template"><field name="name">eLearning: path and course start</field><field name="model_id" ref="model_training_elearning_path_notice"/><field name="subject">Information about your autonomous path</field><field name="lang">{{ object.activation_id.registration_id.user_id.partner_id.lang }}</field><field name="email_from">{{ object.company_id.partner_id.email_formatted or user.partner_id.email_formatted }}</field><field name="partner_to">{{ object.activation_id.registration_id.user_id.partner_id.id }}</field><field name="auto_delete" eval="False"/><field name="body_html" type="html"><div><p t-if="object.item_id">A consultation period is authorized for a course of your path, from <span t-field="object.item_id.access_started_at"/> to <span t-field="object.item_id.access_ends_at"/>. The actual dates do not depend on your first sign-in.</p><p t-else="">Your autonomous path is activated. The included courses open as soon as their prerequisites are met, before the start deadline set on <span t-field="object.activation_id.starts_until"/>.</p><p><a t-att-href="object.get_base_url() + '/my/learning-paths/%s' % object.activation_id.registration_id.id">View my authenticated path and its dates</a></p><p>Materials and individual results remain in your private space.</p></div></field></record>
 <record id="cron_path_starts" model="ir.cron"><field name="name">eLearning : démarrages des cours de parcours</field><field name="model_id" ref="model_training_elearning_path_item"/><field name="state">code</field><field name="code">model._cron_path_starts()</field><field name="interval_number">5</field><field name="interval_type">minutes</field><field name="active" eval="True"/></record>
 <record id="cron_path_notifications" model="ir.cron"><field name="name">eLearning : notifications de parcours</field><field name="model_id" ref="model_training_elearning_path_notice"/><field name="state">code</field><field name="code">model._cron_path_notifications()</field><field name="interval_number">10</field><field name="interval_type">minutes</field><field name="active" eval="True"/></record>
</odoo>
