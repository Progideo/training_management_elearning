<odoo>
 <record id="practical_assignment_notice" model="mail.template"><field name="name">eLearning: practical work review assigned</field><field name="model_id" ref="model_training_elearning_review_notice"/><field name="subject">A practical work submission awaits your review</field><field name="lang">{{ object.reviewer_id.partner_id.lang }}</field><field name="email_from">{{ object.company_id.partner_id.email_formatted or user.partner_id.email_formatted }}</field><field name="partner_to">{{ object.reviewer_id.partner_id.id }}</field><field name="auto_delete" eval="False"/><field name="body_html" type="html"><div><p>A submission is assigned to you. Review deadline: <span t-field="object.queue_id.due_at"/>.</p><p>Open your Odoo space, menu Autonomous Learning / Practical Work Reviews. Files and individual details remain in the private space. If a more recent submission replaces the pending candidate, the initial deadline is kept.</p></div></field></record>
 <record id="practical_feedback_notice" model="mail.template"><field name="name">eLearning: individual practical work feedback published</field><field name="model_id" ref="model_training_elearning_review_notice"/><field name="subject">Feedback on your practical work is available</field><field name="lang">{{ object.queue_id.membership_id.learning_user_id.partner_id.lang }}</field><field name="email_from">{{ object.company_id.partner_id.email_formatted or user.partner_id.email_formatted }}</field><field name="partner_to">{{ object.queue_id.membership_id.learning_user_id.partner_id.id }}</field><field name="auto_delete" eval="False"/><field name="body_html" type="html"><div><p>Individual feedback is published in your private space. It gives the result and any revision conditions.</p><p><a t-att-href="object.get_base_url() + '/my/learning-submissions/%s' % object.submission_id.id">View my submission and its feedback</a></p><p>Assessments, criteria and files remain in this authenticated space.</p></div></field></record>
 <record id="cron_review_notifications" model="ir.cron"><field name="name">eLearning : suivi des notifications de correction</field><field name="model_id" ref="model_training_elearning_review_notice"/><field name="state">code</field><field name="code">model._cron_review_notifications()</field><field name="interval_number">10</field><field name="interval_type">minutes</field><field name="active" eval="True"/></record>
 <record id="cron_review_closure" model="ir.cron"><field name="name">eLearning : clôture des révisions de TP</field><field name="model_id" ref="model_training_elearning_review_queue"/><field name="state">code</field><field name="code">model._cron_review_closure()</field><field name="interval_number">30</field><field name="interval_type">minutes</field><field name="active" eval="True"/></record>
</odoo>
