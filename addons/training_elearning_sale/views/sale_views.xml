<odoo>
<record id="product_learning" model="ir.ui.view"><field name="name">product.autonomous.offer</field><field name="model">product.template</field><field name="inherit_id" ref="product.product_template_only_form_view"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Offre autonome" groups="training_elearning_sale.group_learning_sales_manager"><group><field name="learning_channel_id" domain="[('training_course_id','!=',False),('learning_state','=','published')]"/><field name="learning_access_months"/><field name="learning_assignment_months"/></group></page></xpath></field></record>
<record id="sale_learning" model="ir.ui.view"><field name="name">sale.autonomous.offers</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Accès autonomes" groups="training_elearning_sale.group_learning_sales_manager"><field name="order_line" readonly="0"><list create="0" delete="0" editable="bottom"><field name="product_id" readonly="1"/><field name="product_uom_qty" readonly="1"/><field name="learning_channel_id"/><field name="learning_access_months"/><field name="learning_assignment_months"/><field name="learning_purchase_kind" readonly="state not in ('draft', 'sent')"/><field name="state" column_invisible="1"/><field name="learning_authorized_at"/><field name="learning_authorized_by" optional="hide"/><field name="learning_authorization_reason" optional="hide"/><field name="learning_assign_until"/><button name="action_learning_authorization" type="object" string="Autoriser les accès" invisible="not learning_channel_id or learning_authorized_at or state != 'sale'"/></list></field><p>La confirmation ne crée aucun accès. Autorisez les lignes après vérification du règlement ou d’un accord commercial, puis préparez les sièges nominatifs.</p></page></xpath></field></record>
<record id="authorization_form" model="ir.ui.view"><field name="name">autonomous.sale.authorization</field><field name="model">training.elearning.sale.authorization</field><field name="arch" type="xml"><form string="Autorisation commerciale"><group><field name="line_id" readonly="1"/><field name="reason"/></group><footer><button name="action_apply" type="object" string="Autoriser" class="btn-primary"/><button special="cancel" string="Annuler"/></footer></form></field></record>
<record id="seat_list" model="ir.ui.view"><field name="name">autonomous.sale.seat.list</field><field name="model">training.elearning.sale.allocation</field><field name="arch" type="xml"><list><field name="line_id"/><field name="partner_id"/><field name="activated_at"/><field name="access_ends_at"/><field name="notification_state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="seat_form" model="ir.ui.view"><field name="name">autonomous.sale.seat.form</field><field name="model">training.elearning.sale.allocation</field><field name="arch" type="xml"><form string="Siège nominatif"><header><button name="action_learning_prepare_portal" type="object" string="Gérer le compte portail"/><button name="action_learning_activate" type="object" string="Activer l’accès autorisé" class="btn-primary" invisible="activated_at"/></header><sheet><group><field name="line_id" readonly="id" domain="[('learning_channel_id','!=',False),('state','!=','cancel')]"/><field name="partner_id" readonly="activated_at"/><field name="membership_id" readonly="1"/><field name="company_id" readonly="1"/><field name="activated_at"/><field name="access_started_at"/><field name="access_ends_at"/><field name="notification_state"/></group></sheet><chatter/></form></field></record>
<record id="seat_action" model="ir.actions.act_window"><field name="name">Sièges nominatifs</field><field name="res_model">training.elearning.sale.allocation</field><field name="view_mode">list,form</field></record>
<menuitem id="learning_seats" name="Sièges nominatifs" parent="training_elearning.learning_root" action="seat_action" groups="training_elearning_sale.group_learning_sales_manager" sequence="30"/>
</odoo>
