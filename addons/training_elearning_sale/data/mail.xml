<odoo noupdate="1"><record id="access_notification" model="mail.template"><field name="name">Autonomous access activated</field><field name="model_id" ref="model_training_elearning_sale_allocation"/><field name="subject">Votre accès pédagogique est activé</field><field name="email_to">{{ object.partner_id.email }}</field><field name="body_html" type="html"><div><p>Votre accès au cours <t t-out="object.line_id.learning_channel_id.name"/> est activé jusqu’au <t t-out="object.access_ends_at"/>.</p><p><a t-att-href="'/my/learning/%s' % object.membership_id.id">Ouvrir mon espace apprenant</a></p></div></field></record><record id="cron_access_notification_errors" model="ir.cron"><field name="name">Autonomous access notification failures</field><field name="model_id" ref="model_training_elearning_sale_allocation"/><field name="state">code</field><field name="code">model._cron_learning_notifications()</field><field name="interval_number">1</field><field name="interval_type">hours</field></record></odoo>
