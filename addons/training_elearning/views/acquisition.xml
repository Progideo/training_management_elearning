<odoo>
 <record id="acquisition_invalidate_form" model="ir.ui.view"><field name="name">learning.acquisition.invalidate.form</field><field name="model">training.elearning.acquisition.invalidate</field><field name="arch" type="xml"><form string="Invalider un acquis avec motif"><group><field name="membership_id"/><field name="allowed_slide_ids" invisible="1"/><field name="slide_id" domain="[('id','in',allowed_slide_ids)]" options="{'no_create':True}"/><field name="reason"/><field name="withdraw_certificates"/><field name="request_key" invisible="1"/></group><p>Les preuves et dates d’origine sont conservées. Cette décision n’ouvre aucun droit d’accès. Un nouvel acquis exige une nouvelle preuve recevable.</p><footer><button name="action_apply" type="object" string="Enregistrer l’invalidation" class="btn-primary"/><button special="cancel" string="Annuler"/></footer></form></field></record>
 <record id="member_acquisition_action" model="ir.ui.view"><field name="name">learning.member.acquisition.decision</field><field name="model">slide.channel.partner</field><field name="inherit_id" ref="training_elearning.member_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_learning_invalidate_acquisition" type="object" string="Invalider un acquis" groups="training_elearning.group_elearning_pedagogy_manager" invisible="not learning_started_at"/></xpath></field></record>
 <record id="acquisition_invalidation_list" model="ir.ui.view"><field name="name">learning.acquisition.history.list</field><field name="model">training.elearning.acquisition.invalidation</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="membership_id"/><field name="slide_id"/><field name="invalidated_at"/><field name="actor_id"/><field name="restored_at"/><field name="needs_certificate_review"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="acquisition_invalidation_form" model="ir.ui.view"><field name="name">learning.acquisition.history.form</field><field name="model">training.elearning.acquisition.invalidation</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><group><field name="membership_id"/><field name="slide_id"/><field name="actor_id"/><field name="invalidated_at"/><field name="previous_valid_at"/><field name="restored_at"/><field name="reason"/><field name="needs_certificate_review"/><field name="certificate_ids" widget="many2many_tags" options="{'no_create':True}"/><field name="company_id" groups="base.group_multi_company"/></group></sheet></form></field></record>
 <record id="acquisition_invalidation_search" model="ir.ui.view"><field name="name">learning.acquisition.history.search</field><field name="model">training.elearning.acquisition.invalidation</field><field name="arch" type="xml"><search><field name="membership_id"/><field name="slide_id"/><filter name="pending_certificate_decision" string="Attestations à vérifier" domain="[('certificate_ids.state','=','valid'),('restored_at','=',False)]"/></search></field></record>
 <record id="acquisition_invalidation_action" model="ir.actions.act_window"><field name="name">Invalidations des acquis</field><field name="res_model">training.elearning.acquisition.invalidation</field><field name="view_mode">list,form</field></record>
 <menuitem id="learning_acquisition_history" name="Invalidations des acquis" parent="learning_root" action="acquisition_invalidation_action" groups="training_elearning.group_elearning_pedagogy_manager"/>
</odoo>
