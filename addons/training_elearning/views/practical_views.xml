<odoo>
 <record id="practical_list" model="ir.ui.view"><field name="name">learning.practical.list</field><field name="model">training.elearning.practical</field><field name="arch" type="xml"><list><field name="name"/><field name="training_course_id"/><field name="version_ref"/><field name="criterion"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="practical_form" model="ir.ui.view"><field name="name">learning.practical.form</field><field name="model">training.elearning.practical</field><field name="arch" type="xml"><form string="Travail pratique versionné"><header><button name="action_publish" type="object" groups="training_elearning.group_elearning_author" string="Publier la version" class="btn-primary" invisible="state != 'draft'"/><button name="action_new_version" type="object" groups="training_elearning.group_elearning_author" string="Nouvelle version" invisible="state != 'published'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="state == 'published'"/><field name="training_course_id" readonly="id"/><field name="company_id" groups="base.group_multi_company"/><field name="origin_id"/><field name="version_ref" readonly="state == 'published'"/><field name="revision_reason" readonly="state == 'published'"/><field name="criterion" readonly="state == 'published'"/><field name="published_at"/></group><group name="learning_instructions" string="Consigne textuelle"><field name="instructions" readonly="state == 'published'" nolabel="1"/></group><group name="learning_upload_conditions" string="Conditions de dépôt" invisible="criterion != 'deposit'"><field name="upload_extensions" readonly="state == 'published'"/><field name="max_files" readonly="state == 'published'"/><field name="file_mib" readonly="state == 'published'"/><field name="total_mib" readonly="state == 'published'"/></group><p>Une autoévaluation est une déclaration de l’apprenant. Un dépôt recevable confirme la réception conforme aux conditions annoncées, sans validation de qualité pédagogique. Les versions publiées restent conservées.</p></sheet></form></field></record>
 <record id="practical_action" model="ir.actions.act_window"><field name="name">Travaux pratiques</field><field name="res_model">training.elearning.practical</field><field name="view_mode">list,form</field></record>
 <menuitem id="learning_practicals" name="Travaux pratiques" parent="training_elearning.learning_root" action="practical_action" groups="training_elearning.group_elearning_author" sequence="15"/>
 <record id="course_practical_form" model="ir.ui.view"><field name="name">learning.course.practical.form</field><field name="model">slide.channel</field><field name="inherit_id" ref="training_elearning.course_form"/><field name="arch" type="xml"><xpath expr="//field[@name='slide_ids']/form/group[@name='learning_content']" position="inside"><button name="action_learning_practical_revision" type="object" string="Changer la version du TP" invisible="not id or slide_category != 'learning_task'"/><field name="learning_practical_id" invisible="slide_category != 'learning_task'" domain="[('training_course_id','=',parent.training_course_id),('state','=','published')]" options="{'no_create':True}"/></xpath></field></record>
 <record id="submission_list" model="ir.ui.view"><field name="name">learning.submission.list</field><field name="model">training.elearning.submission</field><field name="arch" type="xml"><list create="0" delete="0"><field name="membership_id"/><field name="slide_id"/><field name="practical_id"/><field name="received_at"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="submission_form" model="ir.ui.view"><field name="name">learning.submission.form</field><field name="model">training.elearning.submission</field><field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_private_payload" type="object" string="Ouvrir les fichiers privés" groups="training_elearning.group_elearning_pedagogy_manager,training_elearning.group_elearning_reviewer"/></header><sheet><group><field name="learner_name"/><field name="membership_id" groups="training_elearning.group_elearning_manager"/><field name="slide_id" groups="training_elearning.group_elearning_manager"/><field name="practical_id"/><field name="received_at"/><field name="state"/></group><p>Les données de suivi du dépôt sont distinctes des fichiers de travail, réservés à la coordination pédagogique habilitée.</p></sheet></form></field></record>
 <record id="payload_form" model="ir.ui.view"><field name="name">learning.submission.payload.form</field><field name="model">training.elearning.submission.payload</field><field name="arch" type="xml"><form create="0" delete="0"><sheet><group><field name="submission_id"/><field name="company_id" groups="base.group_multi_company"/><field name="file_ids" widget="many2many_binary" readonly="1"/></group></sheet></form></field></record>
 <record id="submission_action" model="ir.actions.act_window"><field name="name">Dépôts de TP</field><field name="res_model">training.elearning.submission</field><field name="view_mode">list,form</field></record>
 <menuitem id="learning_submissions" name="Dépôts de TP" parent="training_elearning.learning_root" action="submission_action" groups="training_elearning.group_elearning_manager" sequence="45"/>
 <record id="upload_policy_form" model="ir.ui.view"><field name="name">learning.company.upload.policy</field><field name="model">res.company</field><field name="arch" type="xml"><form create="0" delete="0"><sheet><group><field name="name" readonly="1"/><field name="learning_submission_extensions"/><field name="learning_submission_max_files"/><field name="learning_submission_file_mib"/><field name="learning_submission_total_mib"/></group><p>Ces plafonds s’appliquent aux versions de TP à publier. Les versions déjà publiées conservent leurs conditions. Formats supplémentaires reconnus : images GIF, WebP, BMP, TIFF ; textes Markdown, JSON et XML. Les archives autonomes, exécutables et macros ne sont pas admis.</p></sheet></form></field></record>
 <record id="practical_revision_form" model="ir.ui.view"><field name="name">learning.practical.revision.form</field><field name="model">training.elearning.practical.revision</field><field name="arch" type="xml"><form string="Sélectionner une autre version de TP"><group><field name="slide_id" readonly="1"/><field name="practical_id" domain="[('state','=','published')]" options="{'no_create':True}"/><field name="reason"/></group><p>Les achats confirmés et les adhésions déjà activées gardent leur version. Un changement de critère ou d’obligation exige une nouvelle édition.</p><footer><button name="action_apply" type="object" string="Appliquer aux nouvelles ventes et inscriptions" class="btn-primary"/><button special="cancel" string="Annuler"/></footer></form></field></record>
 <record id="upload_policy_list" model="ir.ui.view"><field name="name">learning.company.upload.policy.list</field><field name="model">res.company</field><field name="arch" type="xml"><list create="0" delete="0"><field name="name"/><field name="learning_submission_max_files"/><field name="learning_submission_file_mib"/><field name="learning_submission_total_mib"/></list></field></record>
 <record id="upload_policy_action" model="ir.actions.act_window"><field name="name">Plafonds des dépôts</field><field name="res_model">res.company</field><field name="view_mode">list,form</field><field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('upload_policy_list')}),(0,0,{'view_mode':'form','view_id':ref('upload_policy_form')})]"/><field name="domain">[('id','in',context.get('allowed_company_ids', []))]</field></record>
 <menuitem id="learning_upload_policy" name="Plafonds des dépôts" parent="training_elearning.learning_root" action="upload_policy_action" groups="base.group_system" sequence="95"/>
</odoo>
