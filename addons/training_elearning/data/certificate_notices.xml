<odoo>
 <record id="certificate_notice_template" model="mail.template"><field name="name">eLearning : historique d’attestations modifié</field><field name="model_id" ref="model_training_elearning_certificate_notice"/><field name="subject">Mise à jour de vos attestations eLearning</field><field name="email_from">{{ object.company_id.partner_id.email_formatted or user.partner_id.email_formatted }}</field><field name="partner_to">{{ object.certificate_id.user_id.partner_id.id }}</field><field name="auto_delete" eval="False"/><field name="body_html" type="html"><div><p>Votre historique d’attestations eLearning a été mis à jour. Consultez le statut actuel et vos documents dans votre espace personnel authentifié.</p><p><a t-att-href="object.get_base_url() + '/my/learning-certificates'">Consulter mes attestations</a></p><p>Les documents et liens de vérification ne sont pas joints à ce message.</p></div></field></record>
 <record id="cron_certificate_notifications" model="ir.cron"><field name="name">eLearning : suivi des notifications d’attestation</field><field name="model_id" ref="model_training_elearning_certificate_notice"/><field name="state">code</field><field name="code">model._cron_certificate_notifications()</field><field name="interval_number">5</field><field name="interval_type">minutes</field><field name="active" eval="True"/></record>
</odoo>
