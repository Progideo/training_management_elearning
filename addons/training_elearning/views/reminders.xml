<odoo>
 <record id="reminder_list" model="ir.ui.view"><field name="name">learning.reminder.list</field><field name="model">training.elearning.reminder</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="kind"/><field name="partner_id"/><field name="due_at"/><field name="state"/><field name="sent_at"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
 <record id="reminder_form" model="ir.ui.view"><field name="name">learning.reminder.form</field><field name="model">training.elearning.reminder</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_retry" type="object" string="Réessayer l’envoi" invisible="state != 'exception'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="kind"/><field name="partner_id"/><field name="membership_id"/><field name="activation_id"/><field name="queue_id"/><field name="due_at"/><field name="deadline"/><field name="sent_at"/><field name="company_id" groups="base.group_multi_company"/></group></sheet><chatter/></form></field></record>
 <record id="reminder_action" model="ir.actions.act_window"><field name="name">Notifications et rappels</field><field name="res_model">training.elearning.reminder</field><field name="view_mode">list,form</field></record>
 <menuitem id="learning_reminders" name="Notifications et rappels" parent="learning_root" action="reminder_action" groups="training_elearning.group_elearning_pedagogy_manager"/>
 <record id="company_reminder_policy" model="ir.ui.view"><field name="name">company.learning.reminders</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Rappels des formations autonomes" groups="base.group_system"><p>Délais en jours ; zéro désactive le rappel. Les modifications ne déclenchent aucun rattrapage rétroactif.</p><field name="learning_notice_long_days"/><field name="learning_notice_short_days"/><field name="learning_notice_revision_days"/><field name="learning_notice_correction_days"/></group></xpath></field></record>
</odoo>
