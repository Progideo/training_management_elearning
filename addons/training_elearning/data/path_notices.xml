<odoo>
 <record id="path_activation_notice" model="mail.template"><field name="name">eLearning — parcours et démarrage de cours</field><field name="model_id" ref="model_training_elearning_path_notice"/><field name="subject">Information sur votre parcours autonome</field><field name="email_from">{{ object.company_id.partner_id.email_formatted or user.partner_id.email_formatted }}</field><field name="partner_to">{{ object.activation_id.registration_id.user_id.partner_id.id }}</field><field name="auto_delete" eval="False"/><field name="body_html" type="html"><div><p t-if="object.item_id">Une période de consultation est autorisée pour un cours de votre parcours, du <span t-field="object.item_id.access_started_at"/> au <span t-field="object.item_id.access_ends_at"/>. Les dates effectives sont indépendantes de votre première connexion.</p><p t-else="">Votre parcours autonome est activé. Les cours inclus s’ouvrent dès leurs prérequis satisfaits, avant la limite de démarrage fixée au <span t-field="object.activation_id.starts_until"/>.</p><p><a t-att-href="object.get_base_url() + '/my/learning-paths/%s' % object.activation_id.registration_id.id">Consulter mon parcours authentifié et ses dates</a></p><p>Les supports et résultats individuels restent dans votre espace privé.</p></div></field></record>
 <record id="cron_path_starts" model="ir.cron"><field name="name">eLearning : démarrages des cours de parcours</field><field name="model_id" ref="model_training_elearning_path_item"/><field name="state">code</field><field name="code">model._cron_path_starts()</field><field name="interval_number">5</field><field name="interval_type">minutes</field><field name="active" eval="True"/></record>
 <record id="cron_path_notifications" model="ir.cron"><field name="name">eLearning : notifications de parcours</field><field name="model_id" ref="model_training_elearning_path_notice"/><field name="state">code</field><field name="code">model._cron_path_notifications()</field><field name="interval_number">10</field><field name="interval_type">minutes</field><field name="active" eval="True"/></record>
</odoo>
